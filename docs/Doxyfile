# Doxyfile for Robosample (disasm) — curated, minimal, maintainable.
# Only settings that matter are listed; Doxygen defaults cover the rest.
# Generates HTML + XML + Graphviz call/caller/class/include graphs for
# robosample's OWN source only (src/ + include/) — vendored deps are excluded.
#
# Run from the repo root:   doxygen docs/Doxyfile
# Or via the pipeline:      python3 scripts/generate_docs.py
#
# NOTE: the codebase currently has plentiful plain `//` comments but no
# Doxygen `///`/`@brief` blocks, so EXTRACT_ALL=YES is used to get maximal
# structural + call-graph coverage. Per-function description text is recovered
# separately (verbatim leading comments) by scripts/gen_api_index.py.

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NAME           = "Robosample"
PROJECT_BRIEF          = "Rigid-body (internal-coordinate) molecular simulation via robot mechanics — GCHMC sampler"
OUTPUT_DIRECTORY       = docs/generated/doxygen
CREATE_SUBDIRS         = NO
QUIET                  = YES
WARN_LOGFILE           = docs/generated/doxygen/doxygen-warnings.log
WARN_IF_UNDOCUMENTED   = NO
WARN_NO_PARAMDOC       = NO

#---------------------------------------------------------------------------
# Input scope — WHITELIST robosample's own source only.
# (openmm/ ~410k LOC, pybind11/ ~47k LOC and other vendored trees live under
#  the repo root and MUST NOT be ingested — they would swamp every graph.)
#---------------------------------------------------------------------------
INPUT                  = src include
RECURSIVE              = YES
FILE_PATTERNS          = *.cpp *.h *.hpp *.cc *.hh
EXCLUDE_SYMLINKS       = YES
# Belt-and-suspenders in case INPUT is ever widened:
EXCLUDE_PATTERNS       = */openmm/* */pybind11/* */units/* */pcg-cpp/* \
                         */build/* */references/* */examples/* */tests/data/*

#---------------------------------------------------------------------------
# What to extract
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
JAVADOC_AUTOBRIEF      = YES
OPTIMIZE_OUTPUT_FOR_C  = NO
BUILTIN_STL_SUPPORT    = YES

#---------------------------------------------------------------------------
# Preprocessing — tame the pybind11 and attribute macros so PyBind11.cpp and
# the headers parse cleanly (EXPAND_ONLY_PREDEF keeps expansion controlled).
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SEARCH_INCLUDES        = YES
PREDEFINED             = "PYBIND11_MODULE(variable,name)=void name(pybind11::module_ variable)" \
                         "PYBIND11_EXPORT=" \
                         "PYBIND11_NAMESPACE=pybind11" \
                         "PYBIND11_NOINLINE=" \
                         "__attribute__(x)=" \
                         "alignas(x)=" \
                         "ROBO_INLINE=" \
                         "__restrict__="

#---------------------------------------------------------------------------
# Source browser + call/reference relations (textual lists survive graph caps)
#---------------------------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES
STRIP_CODE_COMMENTS    = NO
VERBATIM_HEADERS       = YES

#---------------------------------------------------------------------------
# Graphviz graphs
#---------------------------------------------------------------------------
HAVE_DOT               = YES
DOT_NUM_THREADS        = 2
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
TEMPLATE_RELATIONS     = YES
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_GRAPH_MAX_NODES    = 60
MAX_DOT_GRAPH_DEPTH    = 0
DOT_MULTI_TARGETS      = YES
DOT_CLEANUP            = YES

#---------------------------------------------------------------------------
# Output formats
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .
